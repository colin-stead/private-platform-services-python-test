{
  "openapi": "3.1.0",
  "info": {
    "title": "Urbn",
    "description": "",
    "version": "1.0.0"
  },
  "paths": {
    "/rewards": {
      "get": {
        "summary": "Get Rewards",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Get_Rewards"
      }
    },
    "/customers": {
      "get": {
        "summary": "Get Customers",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Get_Customers",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "\"9dcec49f59819d7eb7ad1aad1f45abede98f06ca\""
          }
        ]
      },
      "put": {
        "summary": "Update Customer",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Update_Customer",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "email": "john.smith@urbn.com",
                "orderTotal": 2000
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Customer",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Create_Customer",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "email": "john.smith@urbn.com",
                "orderTotal": 200
              }
            }
          }
        }
      }
    },
    "/customers/{email}": {
      "get": {
        "summary": "Get Customer Details",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Get_Customer_Details",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "john.smith@urbn.com"
          }
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:7050"
    }
  ]
}